# Supabase project credentials. When these are absent the app runs in demo mode.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical site URL used as the redirect target for Google sign-in, password
# reset links, and account confirmation emails. Supabase Auth only returns the
# browser to a URL allow-listed under Authentication -> URL Configuration, and
# otherwise silently falls back to the project's Site URL. Set this to the
# deployed origin (for example https://scholarpath-addu.vercel.app/) so preview
# and local builds still return to the live prototype.
VITE_SITE_URL=https://scholarpath-addu.vercel.app/